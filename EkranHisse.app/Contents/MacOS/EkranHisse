#!/bin/bash
# EkranHisse.app launcher
RESOURCES="$(cd "$(dirname "$0")/../Resources" && pwd)"
LOG="$HOME/Library/Logs/EkranHisse.log"

# Zaten çalışan örneği kapat. main.py mutlak yolla başlatıldığı için komut
# satırında Resources yolu görünür; pkill bununla eşleşir. (Ayrıca main.py
# içindeki fcntl kilidi ikinci örneği zaten engeller; bu, yeniden başlatmayı
# temizler.)
pkill -f "$RESOURCES/main.py" 2>/dev/null

cd "$RESOURCES"
# Apple Silicon'da arm64 mimarisini zorla (Rosetta karışıklığını önler); Intel
# Mac'te 'arch -arm64' çalışmayacağı için mimariyi algılayıp koşullu seçeriz.
if [ "$(uname -m)" = "arm64" ]; then
    exec arch -arm64 /usr/bin/python3 -W ignore "$RESOURCES/main.py" >> "$LOG" 2>&1
else
    exec /usr/bin/python3 -W ignore "$RESOURCES/main.py" >> "$LOG" 2>&1
fi
